---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('reviews');
const goal = 100;
const statuses = ['Backlog', 'Research & Write', 'SEO Check', 'Ready to Publish', 'Published'];
const reviews = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title ?? entry.id.replaceAll('-', ' '),
  status: entry.data.status ?? 'Backlog',
  author: entry.data.author ?? 'Unassigned',
  category: entry.data.category ?? 'TBD',
  clickup: entry.data.clickup ?? null,
  published_url: entry.data.published_url ?? null,
  clicks: entry.data.clicks ?? null,
  impressions: entry.data.impressions ?? null,
  backlinks: entry.data.backlinks ?? null,
}));
const counts = Object.fromEntries(statuses.map((status) => [status, reviews.filter((r) => r.status === status).length]));
const published = counts['Published'] ?? 0;
---
<BaseLayout title="Dashboard | Blinto Reviews">
  <div class="eyebrow">Private Shopify Review Workspace</div>
  <h1>Shopify App Review Hub</h1>
  <p class="lead">Research, write, review, publish and measure Blinto's Shopify app reviews from one command center. GitHub remains the content source of truth while each operational metric is read from its authoritative system.</p>

  <h2>100 Reviews Dashboard</h2>
  <div class="metric-grid">
    <div class="metric"><strong>{published}</strong><span>Published / {goal}</span></div>
    {statuses.slice(0,4).map((status) => <div class="metric"><strong>{counts[status] ?? 0}</strong><span>{status}</span></div>)}
  </div>

  <div class="source-note"><strong>Data contract:</strong> ClickUp → production status · Review Hub/GitHub → content & previews · Blinto website/CMS → published truth · GSC/GA4 → organic performance · SEO API → rankings/backlinks.</div>

  <h2>Review Pipeline</h2>
  <div class="pipeline filters" id="filters">
    <button class="filter active" data-status="All">All <b>{reviews.length}</b></button>
    {statuses.map((status) => <button class="filter" data-status={status}>{status} <b>{counts[status] ?? 0}</b></button>)}
  </div>

  {reviews.length === 0 ? (
    <div class="empty" style="margin-top:18px">No review records are in the repository yet. The five-review validation pilot can begin from ClickUp; review rows and private previews will appear here as review records are created.</div>
  ) : (
    <div class="report-wrap">
      <table class="report" id="report">
        <thead><tr><th>Review</th><th>Reviewer</th><th>Status</th><th>Preview</th><th>Published</th><th>Clicks</th><th>Impressions</th><th>Backlinks</th></tr></thead>
        <tbody>
          {reviews.map((review) => (
            <tr data-status={review.status}>
              <td><strong>{review.title}</strong><small>{review.category}</small></td>
              <td>{review.author}</td>
              <td><span class="status">{review.status}</span></td>
              <td><a href={`/reviews/${review.id}/`}>Preview</a></td>
              <td>{review.published_url ? <a href={review.published_url}>Live</a> : '—'}</td>
              <td>{review.clicks ?? '—'}</td><td>{review.impressions ?? '—'}</td><td>{review.backlinks ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>Performance Intelligence</h2>
  <div class="integration-grid">
    <div class="integration"><strong>ClickUp</strong><span>Backlog, ownership, due dates and production stages</span><em>Production source</em></div>
    <div class="integration"><strong>Blinto Website</strong><span>Published reviews and live URLs</span><em>Publication source</em></div>
    <div class="integration"><strong>Search Console</strong><span>Clicks, impressions, CTR and search position</span><em>Connect when search data exists</em></div>
    <div class="integration"><strong>Google Analytics</strong><span>Sessions, engagement and conversions</span><em>Connect with performance phase</em></div>
    <div class="integration"><strong>SEO API</strong><span>Rankings, referring domains and backlinks</span><em>Later integration</em></div>
  </div>

  <h2>Quick Access</h2>
  <div class="grid">
    <a class="card" href="/planning/"><span class="status">Plan</span><h3>Planning</h3><p>Category ownership, topic validation and review priorities.</p></a>
    <a class="card" href="/process/"><span class="status">Start here</span><h3>Write a Review</h3><p>Human reviewer + AI writer workflow from testing through SEO handoff.</p></a>
    <a class="card" href="/sops/"><span class="status">Reference</span><h3>Core Strategy & SOPs</h3><p>The complete strategy and detailed standards governing the program.</p></a>
    <a class="card" href="/reviews/"><span class="status">{reviews.length} reviews</span><h3>Review Workspace</h3><p>Open review records, evidence context and rendered private article previews.</p></a>
  </div>

  <h2>Current Phase</h2>
  <div class="empty"><strong>Five-review validation pilot.</strong> Build the minimum repeatable process, publish the first reviews, learn from the workflow and performance data, then scale toward 100.</div>

  <script is:inline>
    document.querySelectorAll('.filter').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('.filter').forEach((b) => b.classList.remove('active'));
        button.classList.add('active');
        const wanted = button.dataset.status;
        document.querySelectorAll('#report tbody tr').forEach((row) => {
          row.style.display = wanted === 'All' || row.dataset.status === wanted ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
