---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  const researchIds = new Set((await getCollection('research')).map((entry) => entry.id));
  return reviews.map((review) => ({
    params: { slug: review.id },
    props: { review, hasResearch: researchIds.has(review.id) },
  }));
}

const { review, hasResearch } = Astro.props;
const { Content } = await render(review);
const fm = review.data ?? {};
---
<BaseLayout title={`${fm.title ?? review.id} | Blinto Reviews`}>
  <div class="eyebrow">Private review preview</div>
  <h1>{fm.title ?? review.id}</h1>
  <div class="pipeline">
    <span>Status: {fm.status ?? 'Unknown'}</span>
    <span>Author: {fm.author ?? 'Unassigned'}</span>
    <span>Category: {fm.category ?? 'TBD'}</span>
    <span>Testing: {fm.testing_level ?? 'Not set'}</span>
  </div>
  {hasResearch && (
    <div class="source-note" style="margin-top:18px">
      <strong>Internal evidence:</strong> the research record behind this article is at <a href={`/research/${review.id}/`}>/research/{review.id}/</a>.
    </div>
  )}
  {fm.thumbnail && (
    <img
      class="review-thumbnail"
      src={fm.thumbnail}
      alt={fm.thumbnail_alt ?? ''}
    />
  )}
  <article class="prose" style="margin-top:20px"><Content /></article>
</BaseLayout>
