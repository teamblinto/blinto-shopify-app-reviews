---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const entries = await getCollection('reviews');
const reviews = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title ?? entry.id.replaceAll('-', ' '),
  status: entry.data.status ?? 'Unknown',
  author: entry.data.author ?? 'Unassigned',
  category: entry.data.category ?? 'TBD',
  thumbnail: entry.data.thumbnail ?? null,
  thumbnail_alt: entry.data.thumbnail_alt ?? '',
}));
---
<BaseLayout title="Reviews | Blinto Reviews">
  <div class="eyebrow">Working content</div>
  <h1>Reviews</h1>
  <p class="lead">Each review has one author and one canonical working record. The internal evidence behind these articles lives under <a href="/research/">Research & Evidence</a>.</p>
  {reviews.length === 0 ? (
    <div class="empty">No review records yet. The first five will be created after category research and app assignments.</div>
  ) : (
    <div class="grid">
      {reviews.map((review) => (
        <a class="card" href={`/reviews/${review.id}/`}>
          {review.thumbnail && <img class="review-card-thumbnail" src={review.thumbnail} alt={review.thumbnail_alt} />}
          <span class="status">{review.status}</span>
          <h3>{review.title}</h3>
          <p>{review.category} · {review.author}</p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
